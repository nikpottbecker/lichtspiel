{
  "name": "lichtspiel",
  "version": "0.1.0",
  "private": true,
  "description": "Lokale Kinoregie für macOS und Windows",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:web": "vite --host 0.0.0.0",
    "dev": "concurrently -k \"vite --host 0.0.0.0\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "tsc -b && vite build",
    "test": "node scripts/test.mjs",
    "package:mac": "npm run build && electron-builder --mac --publish never",
    "package:win": "npm run build && electron-builder --win --publish never",
    "typecheck": "tsc --noEmit",
    "test:browser": "node scripts/browser-tests.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "prettier": "3.6.2",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "app.lichtspiel.desktop",
    "productName": "Lichtspiel",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/*.test.cjs",
      "!electron/README.md",
      "package.json",
      "LICENSE",
      "THIRD_PARTY.md"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.video"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "author": "Nik Pottbecker",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikpottbecker/lichtspiel.git"
  },
  "homepage": "https://github.com/nikpottbecker/lichtspiel#readme",
  "bugs": {
    "url": "https://github.com/nikpottbecker/lichtspiel/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
